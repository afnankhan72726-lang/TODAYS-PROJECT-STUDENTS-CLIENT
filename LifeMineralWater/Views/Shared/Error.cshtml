@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-soft p-5">
            <h2 class="fw-bold text-danger">Something went wrong</h2>
            <p class="text-muted">The request could not be completed. Please try again or contact administration.</p>
            @if (Model?.ShowRequestId == true)
            {
                <p class="mono muted">Request ID: @Model.RequestId</p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-brand mt-3">Back to portal</a>
        </div>
    </div>
</div>
