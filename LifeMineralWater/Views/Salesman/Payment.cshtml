@model PaymentFormVm
@{
    ViewData["Title"] = "Customer money entry";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-action="Index" class="small text-decoration-none muted">← Back to customers</a>
        <div class="card-soft mt-2">
            <div class="card-header">Record amount received from customer</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                }
                <div class="notice mb-4">
                    Selected customer bottle balance: <strong>@Model.CurrentBottleBalance</strong><br />
                    Current money balance: <strong class="money">@Model.CurrentMoneyBalance.ToString("N2")</strong>
                    <div class="small muted mt-1">Collecting money reduces the customer's payable balance and increases your cash in hand.</div>
                </div>
                <form asp-action="Payment" method="post">
                    <div class="mb-3">
                        <label asp-for="Input.CustomerId" class="form-label">Customer</label>
                        <select asp-for="Input.CustomerId" asp-items="Model.Customers" class="form-select" id="customerSelect">
                            <option value="">— Select customer —</option>
                        </select>
                        <span asp-validation-for="Input.CustomerId" class="field-error"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.AmountReceived" class="form-label">Amount received</label>
                            <input asp-for="Input.AmountReceived" class="form-control" type="number" min="0.01" step="0.01" />
                            <span asp-validation-for="Input.AmountReceived" class="field-error"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.EntryDate" class="form-label">Date</label>
                            <input asp-for="Input.EntryDate" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="mt-3 mb-4">
                        <label asp-for="Input.Description" class="form-label">Note (optional)</label>
                        <input asp-for="Input.Description" class="form-control" maxlength="300" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-brand px-4">Save payment</button>
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
