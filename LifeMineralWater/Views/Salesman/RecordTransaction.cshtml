@model LifeMineralWater.Models.Transaction
@{
    ViewData["Title"] = "Record Field Delivery";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white text-center py-4 rounded-top">
                    <h3 class="fw-bold mb-1">Log Distribution Entry</h3>
                    <p class="text-white-50 small mb-0">Customer Node: <span class="text-white fw-semibold">@ViewBag.CustomerName</span></p>
                </div>
                <div class="card-body p-4 p-md-5 bg-white">
                    <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-4 py-2 border-0 rounded-8 small">
                        <span class="text-secondary fw-medium">Applicable Base Standard Rate:</span>
                        <span class="fw-bold text-dark">Rs. @ViewBag.Rate / Bottle</span>
                    </div>

                    <form asp-action="RecordTransaction" method="post">
                        <!-- Critical Hidden Mappings -->
                        <input type="hidden" asp-for="CustomerId" />
                        <input type="hidden" name="activeRate" value="@ViewBag.Rate" />

                        <!-- Filled Bottles Delivered Input Field -->
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-semibold">Filled Water Bottles Delivered</label>
                            <input asp-for="FilledDelivered" type="number" class="form-control form-control-lg border-2" placeholder="0" min="0" required id="filledInput" oninput="calculateTotalBill()" />
                            <span asp-validation-for="FilledDelivered" class="text-danger small"></span>
                        </div>

                        <!-- Empty Bottles Returned Input Field -->
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-semibold">Empty Water Bottles Received / Returned</label>
                            <input asp-for="EmptyReceived" type="number" class="form-control form-control-lg" placeholder="0" min="0" required />
                            <span asp-validation-for="EmptyReceived" class="text-danger small"></span>
                        </div>

                        <!-- Automatically Calculated Total Live Invoice Bill -->
                        <div class="mb-3">
                            <label class="form-label text-secondary small fw-semibold">Generated Total Bill Cost Allocation (Rs.)</label>
                            <input type="text" class="form-control form-control-lg bg-light fw-bold text-dark border-1" id="totalBillDisplay" readonly value="Rs. 0.00" />
                        </div>

                        <!-- Amount Paid / Collection Input Field -->
                        <div class="mb-4">
                            <label class="form-label text-secondary small fw-semibold">Cash Amount Received / Collected (Rs.)</label>
                            <input asp-for="AmountPaid" type="number" class="form-control form-control-lg border-2 border-success" placeholder="0.00" min="0" required />
                            <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                        </div>

                        <!-- Submit Execution Button Grid -->
                        <div class="row g-2">
                            <div class="col-6">
                                <a asp-action="Index" class="btn btn-light w-100 py-2.5 fw-semibold border">Cancel</a>
                            </div>
                            <div class="col-6">
                                <button type="submit" class="btn btn-success w-100 py-2.5 fw-bold shadow-sm">Save Logistics Entry</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Real-time Front-end Interactive Automated Invoice Calculator Script -->
<script>
    function calculateTotalBill() {
        var filledCount = document.getElementById('filledInput').value;
        var rate = @ViewBag.Rate;
        var total = (filledCount ? parseInt(filledCount) : 0) * parseFloat(rate);
        document.getElementById('totalBillDisplay').value = "Rs. " + total.toFixed(2);
    }
</script>