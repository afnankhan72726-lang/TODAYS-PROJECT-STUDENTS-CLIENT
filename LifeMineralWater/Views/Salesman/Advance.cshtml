@model AdvanceInput
@{
    ViewData["Title"] = "Staff advance";
    var staff = ViewBag.Staff as List<SelectListItem> ?? new List<SelectListItem>();
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <a asp-action="Expenses" class="small text-decoration-none muted">← Back to expenses</a>
        <div class="card-soft mt-2">
            <div class="card-header">Record advance given to staff</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                }
                <form asp-action="Advance" method="post">
                    <div class="mb-3">
                        <label asp-for="StaffId" class="form-label">Staff member</label>
                        <select asp-for="StaffId" asp-items="staff" class="form-select"></select>
                        <span asp-validation-for="StaffId" class="field-error"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="Amount" class="form-label">Amount</label>
                            <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" />
                            <span asp-validation-for="Amount" class="field-error"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="AdvanceDate" class="form-label">Date</label>
                            <input asp-for="AdvanceDate" class="form-control" type="date" />
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Note" class="form-label">Note (optional)</label>
                        <input asp-for="Note" class="form-control" maxlength="300" />
                    </div>
                    <button type="submit" class="btn btn-brand w-100">Save advance</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
