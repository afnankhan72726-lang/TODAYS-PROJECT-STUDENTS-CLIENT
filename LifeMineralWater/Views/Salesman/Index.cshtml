@model SalesmanDashboardVm
@{
    ViewData["Title"] = "Field dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-1">Good day, @User.Identity?.Name</h2>
        <div class="text-muted small">Your assigned customers and today's activity</div>
    </div>
    <a class="btn btn-brand" asp-action="Payment">＋ Record customer payment</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi"><div class="kpi-label">Customers served today</div><div class="kpi-value">@Model.Today.CustomersServed</div><div class="kpi-foot">Unique customers</div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi green"><div class="kpi-label">Cash in hand</div><div class="kpi-value money">@Model.CurrentCash.ToString("N2")</div><div class="kpi-foot">Opening @Model.OpeningCash.ToString("N2")</div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi"><div class="kpi-label">Sales today</div><div class="kpi-value money">@Model.Today.Sales.ToString("N2")</div><div class="kpi-foot">@Model.Today.FilledDelivered bottles delivered</div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi amber"><div class="kpi-label">Empties received</div><div class="kpi-value">@Model.Today.EmptyReceived</div><div class="kpi-foot">@Model.Today.Expenses.ToString("N2") expenses today</div></div>
    </div>
</div>

<div class="card-soft">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Assigned active customers</span>
        <span class="badge badge-soft badge-info">@Model.Customers.Count</span>
    </div>
    <div class="table-wrap">
        <table class="table table-hover mb-0">
            <thead><tr><th>Code</th><th>Customer</th><th class="text-center">Bottle balance</th><th class="text-end">Money balance</th><th>Deposit</th><th class="text-end">Action</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td class="mono">@c.Code</td>
                        <td class="fw-semibold">@c.Name</td>
                        <td class="text-center"><span class="badge badge-soft badge-info">@c.BottleBalance bottles</span></td>
                        <td class="text-end money @(c.MoneyBalance > 0 ? "text-danger" : c.MoneyBalance < 0 ? "text-success" : "")">
                            @(c.MoneyBalance > 0 ? c.MoneyBalance.ToString("N2") + " due" : c.MoneyBalance < 0 ? Math.Abs(c.MoneyBalance).ToString("N2") + " advance" : "0.00")
                        </td>
                        <td class="small text-muted">@c.DepositInfo</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-brand" asp-action="Delivery" asp-route-customerId="@c.Id">Bottle entry</a>
                            <a class="btn btn-sm btn-outline-brand" asp-action="Payment" asp-route-customerId="@c.Id">Payment</a>
                        </td>
                    </tr>
                }
                @if (!Model.Customers.Any())
                {
                    <tr><td colspan="6" class="empty-state">No active customers are assigned to you.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
