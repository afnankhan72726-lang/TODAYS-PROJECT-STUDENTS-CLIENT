@model IEnumerable<LifeMineralWater.Models.CustomerProfile>
@{
    ViewData["Title"] = "Salesman Dashboard";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 mb-4 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-1">Salesman Terminal Dashboard</h2>
                <p class="text-muted mb-0">Manage daily field distributions, deliveries, and collections</p>
            </div>
            <div class="bg-primary text-white p-3 rounded shadow-sm text-center" style="min-width: 180px;">
                <span class="small d-block uppercase font-weight-bold text-white-50">Active Salesman</span>
                <span class="fw-bold fs-5">@User.Identity?.Name</span>
            </div>
        </div>
    </div>

    <!-- Active Customers List Grid -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="card-title mb-0 fw-semibold">Assigned Route Customer Directory</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">Profile</th>
                            <th>Customer Name</th>
                            <th>Email Address</th>
                            <th class="text-center">Bottle Balance</th>
                            <th class="text-center">Money Balance</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var customer in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @if (!string.IsNullOrEmpty(customer.ProfilePicturePath))
                                        {
                                            <img src="@customer.ProfilePicturePath" class="rounded-circle border" width="45" height="45" alt="Avatar" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center border fw-bold" style="width: 45px; height: 45px;">
                                                @customer.User?.Name?.Substring(0, 1).ToUpper()
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="fw-semibold text-dark">@customer.User?.Name</span>
                                    </td>
                                    <td><span class="text-muted small">@customer.User?.Email</span></td>
                                    <td class="text-center">
                                        <span class="badge bg-info px-3 py-2 rounded-pill fw-bold">@customer.BottleBalance Bottles</span>
                                    </td>
                                    <td class="text-center">
                                        @if (customer.MoneyBalance > 0)
                                        {
                                            <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold">Rs. @customer.MoneyBalance Due</span>
                                        }
                                        else if (customer.MoneyBalance < 0)
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill fw-bold">Rs. @Math.Abs(customer.MoneyBalance) Adv</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill fw-bold">Rs. 0.00</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="RecordTransaction" asp-route-customerId="@customer.Id" class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm rounded-8">
                                            🚚 New Delivery / Log
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <p class="mb-0">No active customer profiles allocated to the database directory.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>