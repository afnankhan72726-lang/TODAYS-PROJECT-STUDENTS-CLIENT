@model IEnumerable<AuditLog>
@{
    ViewData["Title"] = "Audit log";
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
}
<div class="d-flex justify-content-between align-items-end mb-4">
    <div><h2 class="fw-bold mb-1">Audit log</h2><div class="text-muted small">Automatic, append-only trail written with each business change</div></div>
</div>
<div class="card-soft">
    <div class="table-wrap">
        <table class="table table-hover mb-0">
            <thead><tr><th>When</th><th>Action</th><th>Entity</th><th>Actor</th><th>Reason</th><th>Changes</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="small">@a.OccurredAt.ToString("dd-MM-yyyy HH:mm:ss")</td>
                        <td><span class="badge badge-soft @(a.Action == AuditAction.Insert ? "badge-ok" : a.Action == AuditAction.Update ? "badge-warn" : "badge-bad")">@a.Action</span></td>
                        <td class="small fw-semibold">@a.EntityName #@a.EntityId</td>
                        <td class="small">@a.ActorName</td>
                        <td class="small muted">@a.Reason</td>
                        <td class="small">
                            @if (!string.IsNullOrWhiteSpace(a.AffectedColumns) || !string.IsNullOrWhiteSpace(a.NewValues))
                            {
                                <details>
                                    <summary class="text-decoration-none">View</summary>
                                    <div class="mt-1" style="max-width:360px;max-height:180px;overflow:auto">
                                        @if (!string.IsNullOrWhiteSpace(a.AffectedColumns)) { <div class="muted">Columns: @a.AffectedColumns</div> }
                                        @if (!string.IsNullOrWhiteSpace(a.OldValues)) { <pre class="small mb-1">Old: @a.OldValues</pre> }
                                        @if (!string.IsNullOrWhiteSpace(a.NewValues)) { <pre class="small mb-0">New: @a.NewValues</pre> }
                                    </div>
                                </details>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="6" class="empty-state">No audit entries yet.</td></tr> }
            </tbody>
        </table>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-body d-flex gap-2 align-items-center">
            @if (page > 1) { <a asp-action="Audit" asp-route-page="@(page - 1)" class="btn btn-sm btn-outline-brand">← Previous</a> }
            <span class="small text-muted">Page @(page) of @totalPages</span>
            @if (page < totalPages) { <a asp-action="Audit" asp-route-page="@(page + 1)" class="btn btn-sm btn-outline-brand">Next →</a> }
        </div>
    }
</div>
