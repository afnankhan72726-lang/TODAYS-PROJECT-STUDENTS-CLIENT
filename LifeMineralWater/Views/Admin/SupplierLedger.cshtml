@model IEnumerable<SupplierLedgerEntry>
@{
    ViewData["Title"] = "Supplier ledger";
    var supplier = ViewBag.Supplier as Supplier;
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div><h2 class="fw-bold mb-1">@supplier?.Name</h2><div class="text-muted small">Current payable: <strong class="money">@supplier?.CurrentBalance.ToString("N2")</strong></div></div>
    <a asp-action="Suppliers" class="btn btn-outline-brand">← All suppliers</a>
</div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card-soft">
            <div class="card-header">New ledger entry</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div> }
                <form asp-action="SupplierEntry" method="post">
                    <input type="hidden" name="SupplierId" value="@supplier?.Id" />
                    <div class="mb-2"><label class="form-label small">Entry type</label><select name="EntryType" asp-items="Html.GetEnumSelectList<SupplierEntryType>()" class="form-select"></select></div>
                    <div class="mb-2"><label class="form-label small">Amount</label><input name="Amount" type="number" step="0.01" min="0.01" class="form-control" /></div>
                    <div class="mb-2"><label class="form-label small">Date</label><input name="TransactionDate" type="date" class="form-control" /></div>
                    <div class="mb-3"><label class="form-label small">Description</label><input name="Description" class="form-control" /></div>
                    <button type="submit" class="btn btn-brand w-100">Post entry</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card-soft">
            <div class="table-wrap">
                <table class="table table-hover mb-0">
                    <thead><tr><th>Date</th><th>Type</th><th>Description</th><th class="text-end">Amount</th><th class="text-end">Balance after</th></tr></thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr><td class="small">@e.TransactionDate.ToString("dd-MM-yyyy")</td>
                                <td><span class="badge badge-soft badge-info">@e.EntryType</span></td>
                                <td class="small muted">@e.Description</td>
                                <td class="text-end money">@e.Amount.ToString("N2")</td>
                                <td class="text-end money">@e.BalanceAfter.ToString("N2")</td></tr>
                        }
                        @if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No supplier entries yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
