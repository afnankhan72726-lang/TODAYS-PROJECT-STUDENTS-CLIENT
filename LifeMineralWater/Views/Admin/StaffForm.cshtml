@model StaffEditVm
@{
    ViewData["Title"] = Model.Id == 0 ? "Add staff" : "Edit staff";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-action="Staff" class="small text-decoration-none muted">← Back to staff</a>
        <div class="card-soft mt-2">
            <div class="card-header">@ViewData["Title"]</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div> }
                <form asp-action="StaffForm" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="JoinedOn" />
                    <div class="row g-3">
                        <div class="col-md-4"><label asp-for="Code" class="form-label">Code</label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="field-error"></span></div>
                        <div class="col-md-8"><label asp-for="FullName" class="form-label">Full name</label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="field-error"></span></div>
                        <div class="col-md-6"><label asp-for="Designation" class="form-label">Designation</label><input asp-for="Designation" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="Phone" class="form-label">Phone</label><input asp-for="Phone" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="MonthlySalary" class="form-label">Monthly salary</label><input asp-for="MonthlySalary" class="form-control" type="number" step="0.01" /></div>
                        <div class="col-md-6 d-flex align-items-end pb-2"><div class="form-check"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
                    </div>
                    <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-brand">Save staff</button><a asp-action="Staff" class="btn btn-light">Cancel</a></div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
