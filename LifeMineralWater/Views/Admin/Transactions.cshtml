@model SalesmanHistoryVm
@{
    ViewData["Title"] = "All transactions";
    ViewBag.PagerPage = Model.Page;
    ViewBag.PagerTotal = Model.Rows.TotalPages;
    ViewBag.PagerAction = "Transactions";
    ViewBag.PagerController = "Admin";
    ViewBag.PagerRoute = new Dictionary<string, string>
    {
        ["from"] = Model.From?.ToString("yyyy-MM-dd") ?? "",
        ["to"] = Model.To?.ToString("yyyy-MM-dd") ?? "",
        ["customerId"] = Context.Request.Query["customerId"].ToString(),
        ["salesmanId"] = Context.Request.Query["salesmanId"].ToString()
    };
    var customers = ViewBag.Customers as List<SelectListItem> ?? new();
    var salesmen = ViewBag.Salesmen as List<SelectListItem> ?? new();
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div><h2 class="fw-bold mb-1">All transactions</h2><div class="text-muted small">Ledger is immutable by convention — corrections create audited adjustments</div></div>
    <div class="d-flex gap-2">
        <a asp-action="AdjustBalance" class="btn btn-outline-brand">Adjust balance</a>
        <a asp-action="Requests" class="btn btn-brand">Review requests</a>
    </div>
</div>
<div class="card-soft">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small">From</label><input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-md-3"><label class="form-label small">To</label><input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" /></div>
            <div class="col-md-2"><label class="form-label small">Customer</label><select name="customerId" asp-items="customers" class="form-select form-select-sm"></select></div>
            <div class="col-md-2"><label class="form-label small">Salesman</label><select name="salesmanId" asp-items="salesmen" class="form-select form-select-sm"></select></div>
            <div class="col-md-2"><button class="btn btn-sm btn-brand w-100">Apply filters</button></div>
        </form>
    </div>
    <div class="table-wrap">
        <table class="table table-hover mb-0">
            <thead><tr><th>Date</th><th>Customer</th><th>Type</th><th class="text-center">Filled</th><th class="text-center">Empty</th><th class="text-end">Rate</th><th class="text-end">Sale</th><th class="text-end">Collected</th><th class="text-end">Bottle bal.</th><th class="text-end">Money bal.</th><th class="text-end">Action</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Rows.Items)
                {
                    <tr>
                        <td class="small">@r.EntryDate.ToString("dd-MM-yyyy HH:mm")</td>
                        <td>@r.CustomerName</td>
                        <td><span class="badge badge-soft badge-info">@r.EntryType</span> @if (r.IsPending) { <span class="badge badge-soft badge-warn">Pending</span> }</td>
                        <td class="text-center">@r.Filled</td><td class="text-center">@r.Empty</td>
                        <td class="text-end money">@r.Rate.ToString("N2")</td>
                        <td class="text-end money">@r.SaleAmount.ToString("N2")</td>
                        <td class="text-end money">@r.Received.ToString("N2")</td>
                        <td class="text-end">@r.BottleBalanceAfter</td>
                        <td class="text-end money">@r.MoneyBalanceAfter.ToString("N2")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="EditTransaction" asp-route-id="@r.Id" class="btn btn-sm btn-outline-brand">Edit</a>
                            <form asp-action="DeleteTransaction" asp-route-id="@r.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-light" data-confirm="Delete transaction #@r.Id? Balances will be recalculated.">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Rows.Items.Any()) { <tr><td colspan="11" class="empty-state">No transactions match the selected filters.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body">@await Html.PartialAsync("_Pager")</div>
</div>
