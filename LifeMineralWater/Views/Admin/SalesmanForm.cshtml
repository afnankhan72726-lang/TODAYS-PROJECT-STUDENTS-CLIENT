@model SalesmanEditVm
@{
    ViewData["Title"] = Model.Id == 0 ? "Add salesman" : "Edit salesman";
    var users = ViewBag.SalesmanUsers as List<SelectListItem> ?? new();
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <a asp-action="Salesmen" class="small text-decoration-none muted">← Back to salesmen</a>
        <div class="card-soft mt-2">
            <div class="card-header">@ViewData["Title"]</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div> }
                <form asp-action="SalesmanForm" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-4"><label asp-for="Code" class="form-label">Code</label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="field-error"></span></div>
                        <div class="col-md-8"><label asp-for="UserId" class="form-label">Linked Salesman account</label><select asp-for="UserId" asp-items="users" class="form-select"><option value="">— Select —</option></select><span asp-validation-for="UserId" class="field-error"></span></div>
                        <div class="col-md-6"><label asp-for="OpeningCash" class="form-label">Opening cash</label><input asp-for="OpeningCash" class="form-control" type="number" step="0.01" /></div>
                        <div class="col-md-6 d-flex align-items-end pb-2"><div class="form-check"><input asp-for="IsActive" class="form-check-input" type="checkbox" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
                    </div>
                    <div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-brand">Save salesman</button><a asp-action="Salesmen" class="btn btn-light">Cancel</a></div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
