@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex justify-content-between align-items-end mb-4">
    <div><h2 class="fw-bold mb-1">Products</h2><div class="text-muted small">Catalog used for rate rules and delivery entries</div></div>
    <a asp-action="ProductForm" class="btn btn-brand">＋ Add product</a>
</div>
<div class="card-soft">
    <div class="table-wrap">
        <table class="table table-hover mb-0">
            <thead><tr><th>Code</th><th>Name</th><th>Description</th><th>Status</th><th class="text-end">Action</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr><td class="mono">@p.Code</td><td class="fw-semibold">@p.Name</td><td class="small muted">@p.Description</td>
                        <td><span class="badge badge-soft @(p.IsActive ? "badge-ok" : "badge-bad")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end"><a asp-action="ProductForm" asp-route-id="@p.Id" class="btn btn-sm btn-outline-brand">Edit</a></td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No products yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
