@model CustomerEditVm
@{
    ViewData["Title"] = Model.Id == 0 ? "Add customer" : "Edit customer";
    var users = ViewBag.CustomerUsers as List<SelectListItem> ?? new();
    var salesmen = ViewBag.Salesmen as List<SelectListItem> ?? new();
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <a asp-action="Customers" class="small text-decoration-none muted">← Back to customers</a>
        <div class="card-soft mt-2">
            <div class="card-header">@ViewData["Title"]</div>
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div> }
                <form asp-action="CustomerForm" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3">
                        <div class="col-md-4"><label asp-for="Code" class="form-label">Customer code</label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="field-error"></span></div>
                        <div class="col-md-8"><label asp-for="UserId" class="form-label">Linked Customer account</label><select asp-for="UserId" asp-items="users" class="form-select"><option value="">— Select —</option></select><span asp-validation-for="UserId" class="field-error"></span></div>
                        <div class="col-md-6"><label asp-for="AssignedSalesmanId" class="form-label">Assigned salesman</label><select asp-for="AssignedSalesmanId" asp-items="salesmen" class="form-select"><option value="">— Unassigned —</option></select></div>
                        <div class="col-md-6"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AccountStatus>()" class="form-select"></select></div>
                        <div class="col-md-6"><label asp-for="Phone" class="form-label">Phone</label><input asp-for="Phone" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="Address" class="form-label">Address</label><input asp-for="Address" class="form-control" /></div>
                        <div class="col-md-3"><label asp-for="OpeningBottleBalance" class="form-label">Opening bottles</label><input asp-for="OpeningBottleBalance" class="form-control" type="number" /></div>
                        <div class="col-md-3"><label asp-for="OpeningMoneyBalance" class="form-label">Opening money</label><input asp-for="OpeningMoneyBalance" class="form-control" type="number" step="0.01" /></div>
                        <div class="col-md-3"><label asp-for="DepositAmount" class="form-label">Deposit amount</label><input asp-for="DepositAmount" class="form-control" type="number" step="0.01" /></div>
                        <div class="col-md-3"><label asp-for="DepositBottles" class="form-label">Deposit bottles</label><input asp-for="DepositBottles" class="form-control" type="number" /></div>
                    </div>
                    <div class="notice mt-4 small">Changing opening balances recalculates all ledger snapshots for this customer.</div>
                    <div class="mt-3 d-flex gap-2"><button type="submit" class="btn btn-brand">Save customer</button><a asp-action="Customers" class="btn btn-light">Cancel</a></div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
