@model PagedResult<ExpenseRowDto>
@{
    ViewData["Title"] = "Business expenses";
    ViewBag.PagerPage = Model.Page;
    ViewBag.PagerTotal = Model.TotalPages;
    ViewBag.PagerAction = "Expenses";
    ViewBag.PagerController = "Admin";
}
<div class="d-flex justify-content-between align-items-end mb-4">
    <div><h2 class="fw-bold mb-1">Business expenses</h2><div class="text-muted small">All expenses recorded by salesmen and the owner</div></div>
    <a asp-action="Reports" asp-route-report="expenses" class="btn btn-outline-brand">Expense report</a>
</div>
<div class="card-soft">
    <div class="table-wrap">
        <table class="table table-hover mb-0">
            <thead><tr><th>Date</th><th>Category</th><th>Description</th><th>Recorded by</th><th>Salesman</th><th class="text-end">Amount</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Items)
                {
                    <tr><td class="small">@e.Date.ToString("dd-MM-yyyy")</td>
                        <td><span class="badge badge-soft badge-mute">@e.Category</span></td>
                        <td>@e.Description</td><td class="small">@e.RecordedBy</td><td class="small muted">@e.Salesman</td>
                        <td class="text-end money">@e.Amount.ToString("N2")</td></tr>
                }
                @if (!Model.Items.Any()) { <tr><td colspan="6" class="empty-state">No expenses recorded.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-body">@await Html.PartialAsync("_Pager")</div>
</div>
