@model List<SalesmanCashDto>
@{
    ViewData["Title"] = "Salesmen";
}
<div class="d-flex justify-content-between align-items-end mb-4">
    <div><h2 class="fw-bold mb-1">Salesmen</h2><div class="text-muted small">Cash balance is derived from opening cash plus collections minus expenses and advances</div></div>
    <a asp-action="SalesmanForm" class="btn btn-brand">＋ Add salesman</a>
</div>
<div class="card-soft">
    <div class="table-wrap">
        <table class="table table-hover mb-0">
            <thead><tr><th>Name</th><th class="text-end">Opening cash</th><th class="text-end">Current cash</th><th>Status</th><th class="text-end">Action</th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr><td class="fw-semibold">@s.Name</td><td class="text-end money">@s.OpeningCash.ToString("N2")</td>
                        <td class="text-end money @(s.CurrentCash < 0 ? "text-danger" : "text-success")">@s.CurrentCash.ToString("N2")</td>
                        <td><span class="badge badge-soft @(s.IsActive ? "badge-ok" : "badge-bad")">@(s.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end">
                            <a asp-action="SalesmanForm" asp-route-id="@s.Id" class="btn btn-sm btn-outline-brand">Edit</a>
                            <form asp-action="ToggleSalesman" asp-route-id="@s.Id" method="post" class="d-inline">@Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light" data-confirm="Change status for @s.Name?">Toggle</button></form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="empty-state">No salesmen yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
