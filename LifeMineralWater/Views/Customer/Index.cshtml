@model CustomerPortalVm
@{
    ViewData["Title"] = "My ledger";
    ViewBag.PagerPage = Model.Page;
    ViewBag.PagerTotal = Model.Ledger.TotalPages;
    ViewBag.PagerAction = "Index";
    ViewBag.PagerController = "Customer";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
    <div><h2 class="fw-bold mb-1">Hello, @ViewBag.CustomerName</h2><div class="text-muted small">Your complete bottle and money statement</div></div>
    <div class="d-flex gap-2">
        <a asp-action="Invoice" class="btn btn-brand">Monthly invoice</a>
        <button class="btn btn-light" onclick="window.print()">Print statement</button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi"><div class="kpi-label">Bottle balance</div><div class="kpi-value">@Model.Summary.BottleBalance</div><div class="kpi-foot">Bottles held on deposit</div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi @(Model.Summary.MoneyBalance > 0 ? "red" : "green")">
            <div class="kpi-label">Current money balance</div>
            <div class="kpi-value money">@Model.Summary.MoneyBalance.ToString("N2")</div>
            <div class="kpi-foot">@(Model.Summary.MoneyBalance > 0 ? "Outstanding payable" : Model.Summary.MoneyBalance < 0 ? "Credit / advance" : "No outstanding")</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi amber"><div class="kpi-label">Deposit</div><div class="kpi-value money">@Model.Summary.DepositAmount.ToString("N2")</div><div class="kpi-foot">@Model.Summary.DepositBottles bottles</div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi"><div class="kpi-label">Assigned salesman</div><div class="kpi-value" style="font-size:1.05rem">@Model.Summary.Salesman</div><div class="kpi-foot">Account @Model.Summary.Code</div></div>
    </div>
</div>

<div class="notice mb-4"><strong>Deposit status:</strong> @Model.DepositInfo</div>

<div class="card-soft mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span>General ledger</span>
        <form method="get" class="d-flex gap-2">
            <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <button class="btn btn-sm btn-brand">Filter</button>
        </form>
    </div>
    <div class="table-wrap">
        <table class="table table-hover mb-0">
            <thead><tr><th>Date</th><th>Entry</th><th class="text-center">Filled (+)</th><th class="text-center">Empty (−)</th><th class="text-end">Sales</th><th class="text-end">Payment</th><th class="text-end">Bottle balance</th><th class="text-end">Money balance</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Ledger.Items)
                {
                    <tr>
                        <td>@r.EntryDate.ToString("dd-MM-yyyy")</td>
                        <td><span class="badge badge-soft badge-info">@r.EntryType</span></td>
                        <td class="text-center text-success fw-semibold">@(r.Filled > 0 ? "+" + r.Filled : "—")</td>
                        <td class="text-center text-danger fw-semibold">@(r.Empty > 0 ? "−" + r.Empty : "—")</td>
                        <td class="text-end money">@r.SaleAmount.ToString("N2")</td>
                        <td class="text-end money">@r.Received.ToString("N2")</td>
                        <td class="text-end fw-semibold">@r.BottleBalanceAfter</td>
                        <td class="text-end money fw-semibold">@r.MoneyBalanceAfter.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.Ledger.Items.Any())
                {
                    <tr><td colspan="8" class="empty-state">No ledger entries for the selected period.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body">@await Html.PartialAsync("_Pager")</div>
</div>

<div id="announcements" class="row g-3">
    @foreach (var a in Model.Announcements)
    {
        <div class="col-md-6">
            <div class="card-soft p-3 h-100">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <strong>@a.Title</strong>
                    <span class="badge badge-soft badge-warn">@a.Type</span>
                </div>
                <p class="text-muted small mt-2 mb-1">@a.Message</p>
                <div class="muted" style="font-size:.72rem">Valid until @(a.EndOn?.ToString("dd MMM yyyy") ?? "further notice")</div>
            </div>
        </div>
    }
    @if (!Model.Announcements.Any())
    {
        <div class="col-12"><div class="card-soft p-4 text-center muted">No active promotions at the moment.</div></div>
    }
</div>
