@model IEnumerable<LifeMineralWater.Models.Transaction>
@{
    var profile = ViewBag.Profile as LifeMineralWater.Models.CustomerProfile;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Customer Account Statement Ledger</h2>
        <button onclick="window.print()" class="btn btn-dark btn-sm d-print-none">nn Export Account Invoice PDF</button>
    </div>
    <div class="row mb-4">
        <div class="col-6">
            <div class="p-4 bg-light border border-primary text-center rounded">
                <h6 class="text-secondary uppercase small fw-bold">Current Asset Bottle Balance</h6>
                <h3 class="text-primary fw-bold mt-1">@profile?.BottleBalance Unit Bottles</h3>
            </div>
        </div>
        <div class="col-6">
            <div class="p-4 bg-light border border-danger text-center rounded">
                <h6 class="text-secondary uppercase small fw-bold">Outstanding Net Statement Due</h6>
                <h3 class="text-danger fw-bold mt-1">Rs. @profile?.MoneyBalance</h3>
            </div>
        </div>
    </div>
    <table class="table table-bordered table-striped align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Transaction Date</th>
                <th>Delivered Quantity (+)</th>
                <th>Returned Empty (-)</th>
                <th>Net Cost Allocation</th>
                <th>Total Settled Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CreatedAt.ToShortDateString()</td>
                    <td class="text-success fw-bold">+ @item.FilledDelivered</td>
                    <td class="text-danger fw-bold">- @item.EmptyReceived</td>
                    <td>Rs. @item.TotalBill</td>
                    <td class="text-primary fw-bold">Rs. @item.AmountPaid</td>
                </tr>
            }
        </tbody>
    </table>
</div>