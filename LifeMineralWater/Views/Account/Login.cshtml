@model LifeMineralWater.Models.User
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Login - Life Mineral Water</title>
    <link rel="stylesheet" href="https://jsdelivr.net">
</head>
<body class="bg-light">
    <div class="container d-flex justify-content-center mt-5">
        <div class="card shadow p-4" style="max-width: 400px; width:100%;">
            <h3 class="text-center text-primary fw-bold mb-4">Life Mineral Water</h3>
            <form asp-action="Login" method="post">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center">@ViewBag.Error</div>
                }
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address</label>
                    <input type="email" name="email" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Password</label>
                    <input type="password" name="password" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 mb-3">Sign In</button>
                <p class="text-center small">Need a corporate account? <a asp-action="Register">Register Here</a></p>
            </form>
        </div>
    </div>
</body>
</html>
