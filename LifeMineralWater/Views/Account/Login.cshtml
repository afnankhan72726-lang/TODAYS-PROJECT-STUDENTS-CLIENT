@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — Life Mineral Water</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <style>
        .auth-page { min-height: 100vh; display: grid; place-items: center; padding: 24px;
            background: radial-gradient(circle at 12% 18%, #e0f2fe 0, transparent 42%),
                        radial-gradient(circle at 88% 82%, #dbeafe 0, transparent 40%), #f8fafc; }
        .auth-card { width: 100%; max-width: 420px; border: 1px solid #e2e8f0; border-radius: 18px;
            background: #fff; box-shadow: 0 24px 60px -20px rgba(3,105,161,.25); padding: 34px; }
        .auth-mark { width: 46px; height: 46px; border-radius: 13px; display: grid; place-items: center;
            background: linear-gradient(135deg,#38bdf8,#0369a1); color: #fff; font-weight: 800; letter-spacing: -.5px; }
    </style>
</head>
<body>
<div class="auth-page">
    <div class="auth-card">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="auth-mark">LM</div>
            <div>
                <div class="fw-bold fs-5 lh-sm">Life Mineral Water</div>
                <div class="text-muted small">Secure operations portal</div>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="username" placeholder="you@company.com" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                <label asp-for="RememberMe" class="form-check-label small text-muted">Keep me signed in</label>
            </div>
            <button type="submit" class="btn btn-brand w-100 py-2">Sign in</button>
        </form>

        <div class="mt-4 pt-3 border-top small text-muted">
            Accounts are provisioned by the owner. Contact administration if you need access.
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
