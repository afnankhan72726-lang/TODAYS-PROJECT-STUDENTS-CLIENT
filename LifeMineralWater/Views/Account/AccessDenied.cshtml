@{
    ViewData["Title"] = "Access denied";
}
<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card-soft p-5 text-center">
            <div class="display-6 mb-3">⛔</div>
            <h2 class="fw-bold">Insufficient authorization</h2>
            <p class="text-muted">
                Your account does not have permission for this area, or the record is outside your assigned scope.
            </p>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-brand mt-3">Sign in with another account</a>
        </div>
    </div>
</div>
